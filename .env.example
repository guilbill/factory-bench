# Copy this file to .env.local and fill in your own key:
#   cp .env.example .env.local
#
# Anthropic Claude API key used by the /api/process-image route.
# Create one at https://console.anthropic.com/settings/keys
#
# When deploying to Vercel, set the same variable in
# Project Settings -> Environment Variables for Production, Preview,
# and Development. Never commit a real key: .gitignore ignores .env*
# (this example file is the only exception).
ANTHROPIC_API_KEY=your_api_key_here
